# ImageKit — get these from https://imagekit.io/dashboard/developer/api-keys
# URL Endpoint is public info; the private key must NEVER be exposed to the browser.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Same URL endpoint, exposed to the client for rendering images via the Image component.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Supabase — project settings > Data API for the URL/keys, project settings >
# Database > Connect > Transaction pooler for DATABASE_URL (used by Prisma at
# runtime; schema migrations themselves are applied through the Supabase MCP
# server, not `prisma migrate`, so this is only needed for the app to query).
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Google Cloud Console -> APIs & Services -> Credentials. Enable ONLY the
# "Maps JavaScript API" (geocoding runs through the free Nominatim/OSM
# service instead, so the metered Geocoding/Distance Matrix APIs are never
# called). Restrict the key by HTTP referrer to your dev/prod origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
